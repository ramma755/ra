NODE_ENV=development
PORT=10000

# Database
DATABASE_URL=postgresql://postgres:<password>@db.<project>.supabase.co:5432/postgres?sslmode=require

# OpenAI
OPENAI_API_KEY=<rotate_and_paste_new_key>
OPENAI_MODEL=gpt-4.1-mini

# Twilio WhatsApp Sandbox
TWILIO_ACCOUNT_SID=<new_sid>
TWILIO_AUTH_TOKEN=<new_auth_token>
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# Daraja (sandbox)
DARAJA_BASE_URL=https://sandbox.safaricom.co.ke
DARAJA_CONSUMER_KEY=<new_consumer_key>
DARAJA_CONSUMER_SECRET=<new_consumer_secret>
DARAJA_SHORTCODE=174379
DARAJA_PASSKEY=<new_passkey>
DARAJA_STK_CALLBACK_URL=https://<your-domain>/webhooks/mpesa/stk-callback
DARAJA_B2C_RESULT_URL=https://<your-domain>/webhooks/mpesa/b2c/result
DARAJA_B2C_TIMEOUT_URL=https://<your-domain>/webhooks/mpesa/b2c/timeout
DARAJA_B2B_RESULT_URL=https://<your-domain>/webhooks/mpesa/b2b/result
DARAJA_B2B_TIMEOUT_URL=https://<your-domain>/webhooks/mpesa/b2b/timeout
DARAJA_INITIATOR_NAME=<new_initiator_name>
# Daraja usually expects encrypted credential in production;
# keep sandbox value for local simulation and replace in live setup.
DARAJA_INITIATOR_PASSWORD=<sandbox_security_credential>
DARAJA_B2C_COMMAND_ID=BusinessPayment
DARAJA_B2B_PAYBILL_COMMAND_ID=BusinessPayBill
DARAJA_B2B_TILL_COMMAND_ID=BusinessBuyGoods

# Business rules
PLATFORM_COMMISSION_PERCENT=8
DEFAULT_DELIVERY_FEE_KES=150
TREASURY_SWEEP_THRESHOLD_KES=50000
