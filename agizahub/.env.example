NODE_ENV=development
PORT=10000

# Database
DATABASE_URL=postgresql://postgres:<password>@db.<project>.supabase.co:5432/postgres?sslmode=require

# OpenAI
OPENAI_API_KEY=NONE
OPENAI_MODEL=gpt-4.1-mini
# If using OpenRouter, point AI calls here:
BASE_URL=https://openrouter.ai/api/v1
# Optional OpenRouter metadata headers:
OPENROUTER_HTTP_REFERER=NONE
OPENROUTER_APP_NAME=NONE

# WhatsApp gateway mode: WAHA or TWILIO
WHATSAPP_GATEWAY_PROVIDER=WAHA
WHATSAPP_GATEWAY_API_KEY=NONE

# WAHA gateway (for QR linked live line)
WAHA_BASE_URL=NONE
WAHA_SESSION_NAME=NONE
WAHA_SEND_PATH=/api/sendText
WAHA_LIST_PATH=/api/sendList
WAHA_API_KEY_HEADER=X-Api-Key
WAHA_SESSION_STATUS_PATH=/api/sessions
WAHA_SESSION_START_PATH=/api/sessions/{session}/start
WAHA_WEBHOOK_SECRET=NONE
# Dedicated line linked to WAHA session (used for wa.me marketing links)
WAHA_BOT_PHONE=NONE

# Twilio (optional fallback, only required when WHATSAPP_GATEWAY_PROVIDER=TWILIO)
TWILIO_ACCOUNT_SID=NONE
TWILIO_AUTH_TOKEN=NONE
TWILIO_WHATSAPP_NUMBER=NONE

# Daraja (sandbox)
DARAJA_BASE_URL=https://sandbox.safaricom.co.ke
DARAJA_CONSUMER_KEY=NONE
DARAJA_CONSUMER_SECRET=NONE
DARAJA_SHORTCODE=174379
DARAJA_PASSKEY=NONE
DARAJA_STK_CALLBACK_URL=NONE
DARAJA_B2C_RESULT_URL=NONE
DARAJA_B2C_TIMEOUT_URL=NONE
DARAJA_B2B_RESULT_URL=NONE
DARAJA_B2B_TIMEOUT_URL=NONE
# Required for escrow disbursement release (B2C/B2B legs)
# Sandbox default API user is commonly TestInitiator.
DARAJA_INITIATOR_NAME=TestInitiator
# Use the plain password/security credential for your Daraja API user.
DARAJA_INITIATOR_PASSWORD=NONE
DARAJA_B2C_COMMAND_ID=BusinessPayment
DARAJA_B2B_PAYBILL_COMMAND_ID=BusinessPayBill
DARAJA_B2B_TILL_COMMAND_ID=BusinessBuyGoods
# Optional callback source checks
DARAJA_ENFORCE_IP_WHITELIST=true
# Safaricom callback allowlist format (comma-separated IPs/CIDR)
DARAJA_ALLOWED_IPS=196.201.214.200,196.201.214.206,196.201.213.114,196.201.214.207,196.201.214.208,196.201.213.44,196.201.212.127,196.201.212.128,196.201.212.129,196.201.212.132,196.201.212.136,196.201.212.138,196.201.212.69,196.201.212.74
# Optional advanced override (only if OUTGOING_PAYOUT_FLAT_FEE_KES=0)
# DARAJA_B2C_FEE_RULES_JSON=[{"min":1,"max":1000,"fee":13}]
# DARAJA_B2B_FEE_RULES_JSON=[{"min":1,"max":1000000,"fee":50}]

# Business rules
# Tiered platform commission:
# - below 20,000 => 2%
# - 20,000 and above => 5%
COMMISSION_TIER_THRESHOLD_KES=20000
LOW_VALUE_COMMISSION_PERCENT=2
HIGH_VALUE_COMMISSION_PERCENT=5

# Logistics cut from transporter quote
LOGISTICS_PREMIUM_PERCENT=10

# Incoming payment gateway fee (0.55%, capped at 200, free below 200)
INCOMING_GATEWAY_FEE_PERCENT=0.55
INCOMING_GATEWAY_FEE_CAP_KES=200
INCOMING_GATEWAY_FEE_FREE_BELOW_KES=200

# Outgoing payout fee per disbursement leg
OUTGOING_PAYOUT_FLAT_FEE_KES=50

# Backward-compatible legacy setting (ignored by tiered engine)
MATCHING_COMMISSION_PERCENT=3
TRANSPORT_BASE_FEE_KES=1500
TRANSPORT_BASE_DISTANCE_KM=10
TRANSPORT_PER_KM_FEE_KES=40
# Backward-compatible legacy settings (transport-only now auto-derives requester rate)
TRANSPORT_REQUESTER_COMMISSION_PERCENT=5
TRANSPORTER_SIDE_COMMISSION_PERCENT=10
TRANSPORTER_ASSIGNMENT_TIMEOUT_MINUTES=20
DEFAULT_DELIVERY_FEE_KES=1500
TREASURY_SWEEP_THRESHOLD_KES=50000

# Admin authorization line
ADMIN_WHATSAPP_PHONE=NONE
ADMIN_WHATSAPP_PHONES=NONE
ADMIN_PHONE_1=NONE
ADMIN_NAME=Admin
ADMIN_REQUIRE_TOKEN=true
ADMIN_TOKEN_TTL_MINUTES=5
ADMIN_SESSION_TTL_MINUTES=120
ADMIN_TOKEN_MAX_ATTEMPTS=5
ADMIN_ALERT_CHANNEL=WHATSAPP
ADMIN_ALERT_FALLBACK_DESTINATION=admin-dashboard

# Bot re-engagement behavior (welcome-back prompt after inactivity)
INACTIVITY_WELCOME_MINUTES=30

# Optional: Google Maps Distance Matrix (used before haversine fallback)
GOOGLE_MAPS_API_KEY=NONE
GOOGLE_MAPS_DISTANCE_MATRIX_URL=https://maps.googleapis.com/maps/api/distancematrix/json
DISTANCE_CACHE_TTL_HOURS=168
DISTANCE_CACHE_PRECISION_DP=4
