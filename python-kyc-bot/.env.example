APP_ENV=development
APP_PORT=8080
APP_BASE_URL=http://localhost:8080
DATABASE_URL=sqlite:///./kyc_test_bot.db

# Replace with your Persona sandbox credentials.
PERSONA_API_KEY=NONE
PERSONA_TEMPLATE_ID=NONE
PERSONA_BASE_URL=https://withpersona.com/api/v1
PERSONA_WEBHOOK_SECRET=NONE

# OTP behavior:
# - set OTP_DEBUG_MODE=true for local testing (OTP printed in logs)
# - set OTP_DEBUG_MODE=false and wire your SMS provider in app/otp.py
OTP_DEBUG_MODE=true
OTP_CODE_TTL_SECONDS=300
